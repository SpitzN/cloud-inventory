{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.ui.tsbuildinfo",
    "outDir": "./node_modules/.tmp/ui-types",
    "emitDeclarationOnly": true,
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",

    /* Path alias */
    "paths": { "@/*": ["./src/*"] },

    /* Generated code is held to `strict` alone; the project's extra options are in tsconfig.app.json */
    "strict": true
  },
  "include": ["src/components/ui"]
}
